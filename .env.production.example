# 生产环境模板：使用前为各密钥填写相互独立的随机值。
APP_ENV=production
MYSQL_USER=migration_ddl
MYSQL_PASSWORD=
# 每个运行时/迁移账号使用相互独立的随机值（推荐 openssl rand -hex 32）。
MYSQL_AUTH_RUNTIME_PASSWORD=
MYSQL_USER_RUNTIME_PASSWORD=
MYSQL_CONTENT_RUNTIME_PASSWORD=
MYSQL_SOCIAL_RUNTIME_PASSWORD=
MYSQL_CHAT_RUNTIME_PASSWORD=
MYSQL_MESSAGE_RUNTIME_PASSWORD=
MYSQL_USER_OUTBOX_RELAY_PASSWORD=
# Phinx 迁移专用 DDL 账号；不能复用任一运行时账号或 root。
MYSQL_MIGRATION_PASSWORD=
JWT_SECRET=
WS_TICKET_SECRET=
INTERNAL_RPC_GATEWAY_AUTH_TOKEN=
INTERNAL_RPC_GATEWAY_USER_TOKEN=
INTERNAL_RPC_AUTH_USER_TOKEN=
INTERNAL_RPC_CONTENT_USER_TOKEN=
INTERNAL_RPC_SOCIAL_USER_TOKEN=
INTERNAL_RPC_CHAT_USER_TOKEN=
INTERNAL_RPC_GATEWAY_CONTENT_TOKEN=
INTERNAL_RPC_GATEWAY_SOCIAL_TOKEN=
INTERNAL_RPC_GATEWAY_CHAT_TOKEN=
INTERNAL_RPC_GATEWAY_MESSAGE_TOKEN=
INTERNAL_RPC_CHAT_CONTENT_TOKEN=
INTERNAL_RPC_SOCIAL_CONTENT_TOKEN=
INTERNAL_RPC_MESSAGE_CONTENT_TOKEN=
INTERNAL_RPC_MODERATION_CONTENT_TOKEN=
INTERNAL_RPC_CONTENT_SOCIAL_TOKEN=
INTERNAL_RPC_CHAT_SOCIAL_TOKEN=
INTERNAL_RPC_MESSAGE_CHAT_TOKEN=
ANONYMOUS_IDENTITY_KEY=
RABBITMQ_USER=social_app
RABBITMQ_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BIND_ADDRESS=127.0.0.1
# Internal gRPC transport is fail-closed in production. Set GRPC_TLS_MODE=tls
# for server-authenticated TLS, or mtls plus client cert/key and
# require_and_verify_client_cert for mutual TLS. Keep PEM files outside Git
# and inject their mounted paths through the deployment secret manager.
GRPC_TLS_MODE=tls
GRPC_TLS_CA_FILE=/run/secrets/grpc/ca.pem
GRPC_TLS_KEY_FILE=/run/secrets/grpc/client.key
GRPC_TLS_CERT_FILE=/run/secrets/grpc/client.crt
GRPC_TLS_SERVER_CERT_FILE=/run/secrets/grpc/server.crt
GRPC_TLS_SERVER_KEY_FILE=/run/secrets/grpc/server.key
GRPC_TLS_CLIENT_AUTH_TYPE=no_client_certs
GRPC_TLS_SERVER_NAME=
GRPC_TLS_SERVER_NAME_AUTH_SERVICE=auth-service
GRPC_TLS_SERVER_NAME_USER_SERVICE=user-service
GRPC_TLS_SERVER_NAME_CONTENT_SERVICE=content-service
GRPC_TLS_SERVER_NAME_SOCIAL_SERVICE=social-service
GRPC_TLS_SERVER_NAME_CHAT_SERVICE=chat-service
GRPC_TLS_SERVER_NAME_MESSAGE_SERVICE=message-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ENABLE_DEV_LOGIN=false
DEV_LOGIN_CODE=
# 配置好生产环境 OAuth 凭据之前保持禁用。
ENABLE_WECHAT_LOGIN=false
ENABLE_QQ_LOGIN=false
# 填写明确的可信反向代理地址或 CIDR；不得信任所有地址。
SOCIAL_TRUSTED_PROXY_CIDRS=
# 分层社交限流；限流桶模型参见 README 的“受信代理链与客户端 IP 限流”。
# 限流桶模型；每 IP 总上限须考虑运营商 CGNAT 下的地址共享。
SOCIAL_LOGIN_RATE_LIMIT=60
SOCIAL_LOGIN_RATE_WINDOW_SECONDS=60
SOCIAL_LOGIN_RATE_SCENARIO_LIMIT=30
SOCIAL_LOGIN_RATE_DEVICE_LIMIT=20
SOCIAL_BIND_USER_RATE_LIMIT=10
SOCIAL_BIND_USER_RATE_WINDOW_SECONDS=3600
