# Production template: fill secrets with independent random values before use.
APP_ENV=production
MYSQL_PASSWORD=
JWT_SECRET=
WS_TICKET_SECRET=
INTERNAL_RPC_GATEWAY_AUTH_TOKEN=
INTERNAL_RPC_GATEWAY_USER_TOKEN=
INTERNAL_RPC_AUTH_USER_TOKEN=
RABBITMQ_USER=social_app
RABBITMQ_PASSWORD=
ENABLE_DEV_LOGIN=false
DEV_LOGIN_CODE=
# Keep disabled until the production OAuth credentials are configured.
ENABLE_WECHAT_LOGIN=false
ENABLE_QQ_LOGIN=false
# Set exact trusted reverse proxy addresses/CIDRs; never trust all addresses.
SOCIAL_TRUSTED_PROXY_CIDRS=
# Layered social rate limits; see README "受信代理链与客户端 IP 限流" for the
# bucket model. Size the per-IP ceiling for carrier CGNAT sharing.
SOCIAL_LOGIN_RATE_LIMIT=60
SOCIAL_LOGIN_RATE_WINDOW_SECONDS=60
SOCIAL_LOGIN_RATE_SCENARIO_LIMIT=30
SOCIAL_LOGIN_RATE_DEVICE_LIMIT=20
SOCIAL_BIND_USER_RATE_LIMIT=10
SOCIAL_BIND_USER_RATE_WINDOW_SECONDS=3600
