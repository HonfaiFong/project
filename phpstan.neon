includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    # 基线由安装或未安装 ext-grpc / ext-redis 的主机生成；扩展提供的符号可能随环境变化而不再匹配，不能因此导致检查失
    # 败。
    reportUnmatchedIgnoredErrors: false
    paths:
        - apps
        - services
        - packages
        - database
        - phinx.php
        - contracts/errors
        - contracts/events
        - tests
        - scripts/verify_token_latency_probe.php
    excludePaths:
        # 自动生成的 Protobuf 代码
        - contracts/gen