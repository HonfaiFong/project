{
  "name": "social/backend-monorepo",
  "description": "Anonymous Social Backend Platform Monorepo",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-grpc": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "giggsey/libphonenumber-for-php": "^8.13",
    "google/protobuf": "^4.0",
    "grpc/grpc": "^1.82",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/container": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/validation": "^12.0",
    "monolog/monolog": "^3",
    "php-amqplib/php-amqplib": "^3.7.4",
    "psr/log": "^3.0",
    "robmorgan/phinx": "^0.16",
    "spiral/roadrunner-grpc": "^3.0",
    "workerman/webman-framework": "^2.0",
    "workerman/workerman": "^5.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Contracts\\Errors\\": "contracts/errors/",
      "Contracts\\Events\\": "contracts/events/",
      "Contracts\\Gen\\": "contracts/gen/php/Contracts/Gen/",
      "Packages\\IdGenerator\\": "packages/php/id-generator/src/",
      "Packages\\Tracing\\": "packages/php/tracing/src/",
      "Packages\\Logging\\": "packages/php/logging/src/",
      "Packages\\Outbox\\": "packages/php/outbox/src/",
      "Packages\\Database\\": "packages/php/database/src/",
      "Packages\\GrpcCommon\\": "packages/php/grpc-common/src/",
      "Packages\\Phone\\": "packages/php/phone/src/",
      "Packages\\Identity\\": "packages/php/identity/src/",
      "Apps\\ApiGateway\\": "apps/api-gateway/app/",
      "Services\\AuthService\\": "services/auth-service/src/",
      "Services\\UserService\\": "services/user-service/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
