# 本地开发和 CI 模板；部署时请使用 .env.production.example。
APP_ENV=local
AUTH_ACCESS_TOKEN_REVOCATION_TTL=7200
AUTH_LOGOUT_RATE_LIMIT=60
AUTH_LOGOUT_RATE_WINDOW_SECONDS=60
AUTH_LOGOUT_RATE_DEVICE_LIMIT=20
APP_NAME=social-backend
SERVICE_NAME=api-gateway
SERVICE_INSTANCE_ID=gw-01
METRICS_ALLOWED_CIDRS=

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=social_backend
PG_BIND_ADDRESS=127.0.0.1
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-random-local-postgres-admin-password
PG_MIGRATION_USER=migration_ddl
PG_MIGRATION_PASSWORD=replace-with-random-migration-password
PG_MIGRATION_LOCK_TIMEOUT_MS=10000
PG_MIGRATION_STATEMENT_TIMEOUT_MS=60000

# PostgreSQL 运行时账号密码（各个服务独立，推荐 openssl rand -hex 32）
PG_AUTH_RUNTIME_PASSWORD=replace-with-random-auth-runtime-password
PG_USER_RUNTIME_PASSWORD=replace-with-random-user-runtime-password
PG_CONTENT_RUNTIME_PASSWORD=replace-with-random-content-runtime-password
PG_SOCIAL_RUNTIME_PASSWORD=replace-with-random-social-runtime-password
PG_CHAT_RUNTIME_PASSWORD=replace-with-random-chat-runtime-password
PG_USER_OUTBOX_RELAY_PASSWORD=replace-with-random-user-outbox-relay-password

# MongoDB（MessageService 专用）
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DATABASE=message_db
MONGODB_ADMIN_USER=mongo_admin
MONGODB_ADMIN_PASSWORD=replace-with-random-local-mongo-admin-password
MONGODB_RUNTIME_PASSWORD=replace-with-random-local-mongo-runtime-password
MONGODB_RELAY_PASSWORD=replace-with-random-local-mongo-relay-password
MONGODB_MIGRATION_PASSWORD=replace-with-random-local-mongo-migration-password
MONGODB_PORT=27017
MONGODB_BIND_ADDRESS=127.0.0.1
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=5000
MONGODB_RPC_CONNECT_TIMEOUT_MS=250
MONGODB_RPC_SERVER_SELECTION_TIMEOUT_MS=250
MONGODB_RPC_SOCKET_TIMEOUT_MS=500
MONGODB_RPC_QUERY_TIMEOUT_MS=300
MONGODB_RPC_WRITE_TIMEOUT_MS=250
MONGODB_RPC_COMMIT_TIMEOUT_MS=150
MONGODB_RPC_BUDGET_RESERVE_MS=100
MONGODB_RPC_RETRY_DELAY_MS=10
MONGODB_RPC_MAX_TRANSACTION_ATTEMPTS=3

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PASSWORD=
# 实时网关可通过 TLS 连接托管 Redis 端点。
REDIS_USERNAME=
REDIS_TLS=false

# RabbitMQ（AMQP 任务和 Stream 领域事件）
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_STREAM_PORT=5552
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_USER=social_app
RABBITMQ_PASSWORD=replace-with-random-local-rabbitmq-password

# RustFS 服务管理员（仅用于初始化配置）
RUSTFS_BIND_ADDRESS=127.0.0.1
RUSTFS_ACCESS_KEY=social_storage_admin
RUSTFS_SECRET_KEY=replace-with-random-local-rustfs-secret

# 兼容 S3 的存储客户端配置（MediaService）
STORAGE_ENDPOINT=http://rustfs:9000
# 客户端可访问的 URL；生成预签名 URL 时使用此端点。
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=social_storage_app
STORAGE_SECRET_KEY=replace-with-random-app-storage-secret
STORAGE_BUCKET=social-media
STORAGE_PATH_STYLE=true

# gRPC 服务
GRPC_AUTH_SERVICE=auth-service:50051
GRPC_USER_SERVICE=user-service:50052
# AuthService -> UserService 用户目录调用的单跳预算；须小于网关的 GRPC_AUTH_TIMEOUT_MS，确保外层截止时间起决定作
# 用。
GRPC_USER_DIRECTORY_TIMEOUT_MS=250
GRPC_CONTENT_SERVICE=content-service:50053
GRPC_SOCIAL_SERVICE=social-service:50054
GRPC_CHAT_SERVICE=chat-service:50055
GRPC_MESSAGE_SERVICE=message-service:50056
GRPC_MESSAGE_SEQUENCE_TIMEOUT_MS=250
GRPC_DISCOVERY_SERVICE=discovery-service:50057
GRPC_FEED_SERVICE=feed-service:50058
GRPC_RISK_SERVICE=risk-service:50059
GRPC_MODERATION_SERVICE=moderation-service:50060

# Internal gRPC transport. Local development must opt in to the intentionally
# plaintext mode; production must use tls or mtls. Secure modes read PEM files
# from mounted paths and verify the configured server name.
GRPC_TLS_MODE=plaintext
GRPC_TLS_CA_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_SERVER_CERT_FILE=
GRPC_TLS_SERVER_KEY_FILE=
GRPC_TLS_CLIENT_AUTH_TYPE=no_client_certs
GRPC_TLS_SERVER_NAME=
# When one process calls several services, target-specific names take priority
# over GRPC_TLS_SERVER_NAME (for example, auth-service.internal).
GRPC_TLS_SERVER_NAME_AUTH_SERVICE=
GRPC_TLS_SERVER_NAME_USER_SERVICE=
GRPC_TLS_SERVER_NAME_CONTENT_SERVICE=
GRPC_TLS_SERVER_NAME_SOCIAL_SERVICE=
GRPC_TLS_SERVER_NAME_CHAT_SERVICE=
GRPC_TLS_SERVER_NAME_MESSAGE_SERVICE=

# 可观测性
# Optional: set http://otel-collector:4318 and enable the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-admin-password

# 安全密钥
# 启动前生成相互独立的随机值；部署时不得复用这些占位值。
JWT_SECRET=replace-with-independent-random-jwt-secret-at-least-32-bytes
WS_TICKET_SECRET=replace-with-independent-random-ws-secret-at-least-32-bytes
# 部署时为内部 gRPC 的各个调用方向分别生成随机值。
INTERNAL_RPC_GATEWAY_AUTH_TOKEN=replace-with-independent-random-gateway-auth-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_USER_TOKEN=replace-with-independent-random-gateway-user-token-at-least-32-bytes
INTERNAL_RPC_AUTH_USER_TOKEN=replace-with-independent-random-auth-user-token-at-least-32-bytes
INTERNAL_RPC_CONTENT_USER_TOKEN=replace-with-independent-random-content-user-token-at-least-32-bytes
INTERNAL_RPC_SOCIAL_USER_TOKEN=replace-with-independent-random-social-user-token-at-least-32-bytes
INTERNAL_RPC_CHAT_USER_TOKEN=replace-with-independent-random-chat-user-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_CONTENT_TOKEN=replace-with-independent-random-gateway-content-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_SOCIAL_TOKEN=replace-with-independent-random-gateway-social-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_CHAT_TOKEN=replace-with-independent-random-gateway-chat-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_MESSAGE_TOKEN=replace-with-independent-random-gateway-message-token-at-least-32-bytes
INTERNAL_RPC_CHAT_CONTENT_TOKEN=replace-with-independent-random-chat-content-token-at-least-32-bytes
INTERNAL_RPC_SOCIAL_CONTENT_TOKEN=replace-with-independent-random-social-content-token-at-least-32-bytes
INTERNAL_RPC_MESSAGE_CONTENT_TOKEN=replace-with-independent-random-message-content-token-at-least-32-bytes
INTERNAL_RPC_MODERATION_CONTENT_TOKEN=replace-with-independent-random-moderation-content-token-at-least-32-bytes
INTERNAL_RPC_CONTENT_SOCIAL_TOKEN=replace-with-independent-random-content-social-token-at-least-32-bytes
INTERNAL_RPC_CHAT_SOCIAL_TOKEN=replace-with-independent-random-chat-social-token-at-least-32-bytes
INTERNAL_RPC_MESSAGE_CHAT_TOKEN=replace-with-independent-random-message-chat-token-at-least-32-bytes
INTERNAL_RPC_CHAT_MESSAGE_TOKEN=replace-with-independent-random-chat-message-token-at-least-32-bytes
ANONYMOUS_IDENTITY_KEY=replace-with-independent-random-anonymous-identity-key-at-least-32-bytes

# 社交登录（密钥仅由 auth-service 使用）
ENABLE_WECHAT_LOGIN=false
ENABLE_QQ_LOGIN=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_IDENTITY_NAMESPACE=wechat-main
# 本地端到端测试可通过 compose 的 fake-oauth 服务覆盖这些配置；其他环境保留官方 HTTPS 默认端点。
WECHAT_TOKEN_ENDPOINT=https://api.weixin.qq.com/sns/oauth2/access_token
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=
QQ_IDENTITY_NAMESPACE=qq-main
QQ_TOKEN_ENDPOINT=https://graph.qq.com/oauth2.0/token
QQ_OPEN_ID_ENDPOINT=https://graph.qq.com/oauth2.0/me
# 仅本地或测试环境的模拟 OAuth 服务允许使用 HTTP；生产环境始终使用 HTTPS。
SOCIAL_OAUTH_ALLOW_INSECURE_HTTP=false
SOCIAL_HTTP_CONNECT_TIMEOUT_MS=1000
SOCIAL_HTTP_TIMEOUT_MS=3000
GRPC_AUTH_TIMEOUT_MS=300
# 两个社交 RPC 都会交替发起 OAuth HTTP 请求和 Auth↔User gRPC 调用；QQ 会发起两次 OAuth HTTP 请求，因此各截止时间
# 预算必须大于 2 * SOCIAL_HTTP_TIMEOUT_MS，否则网关拒绝启动。
GRPC_SOCIAL_LOGIN_TIMEOUT_MS=7000
GRPC_SOCIAL_BIND_TIMEOUT_MS=7000
PHONE_DEFAULT_REGION=CN
# 分层社交限流（所有请求均须通过每一层限流桶）：
# SOCIAL_LOGIN_RATE_LIMIT 是登录和绑定共用的每 IP 总上限。运营商 CGNAT 会让多个真实用户共享一个 IPv4，故总上限应
# 宽松；下方场景、设备和用户限流桶负责精细限制。
SOCIAL_LOGIN_RATE_LIMIT=60
SOCIAL_LOGIN_RATE_WINDOW_SECONDS=60
# 窗口内每个 IP 和场景（登录或绑定）的限额。
SOCIAL_LOGIN_RATE_SCENARIO_LIMIT=30
# 每个（IP, device_uuid）组合的限额；仅作为收紧限制的风险信号。
SOCIAL_LOGIN_RATE_DEVICE_LIMIT=20
# 每个已认证用户在独立窗口内的绑定限额。
SOCIAL_BIND_USER_RATE_LIMIT=10
SOCIAL_BIND_USER_RATE_WINDOW_SECONDS=3600
# 仅填写你控制的代理地址；为空时只信任直接连接的对端。
SOCIAL_TRUSTED_PROXY_CIDRS=

# Snowflake 工作槽位（0-31）。compose.yaml 为各服务注入 WORKER_ID；仅在非 Docker 本地运行时设置此项。同一服务的
# 各副本须使用不同值。
# WORKER_ID=1

# 手机短信登录仅用于本地和端到端测试；生产环境由网关路由环境检查和 AuthService 同时禁用。
ENABLE_DEV_LOGIN=true
DEV_LOGIN_CODE=123456
