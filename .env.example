# Local development / CI template. Use .env.production.example for deployment.
APP_ENV=local
APP_NAME=social-backend
SERVICE_NAME=api-gateway
SERVICE_INSTANCE_ID=gw-01

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-random-local-mysql-password

# Databases
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
CONTENT_DB_NAME=content_db
SOCIAL_DB_NAME=social_db
CHAT_DB_NAME=chat_db
MESSAGE_DB_NAME=message_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PASSWORD=
# Realtime gateway can connect to a managed Redis endpoint with TLS.
REDIS_USERNAME=
REDIS_TLS=false

# RabbitMQ (AMQP jobs + Stream domain events)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_STREAM_PORT=5552
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_USER=social_app
RABBITMQ_PASSWORD=replace-with-random-local-rabbitmq-password

# RustFS server administrator (used only for provisioning)
RUSTFS_ACCESS_KEY=social_storage_admin
RUSTFS_SECRET_KEY=replace-with-random-local-rustfs-secret

# S3-compatible storage client configuration (MediaService)
STORAGE_ENDPOINT=http://rustfs:9000
# URL reachable by clients; use this endpoint when generating presigned URLs.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=social_storage_app
STORAGE_SECRET_KEY=replace-with-random-app-storage-secret
STORAGE_BUCKET=social-media
STORAGE_PATH_STYLE=true

# gRPC Services
GRPC_AUTH_SERVICE=auth-service:50051
GRPC_USER_SERVICE=user-service:50052
# Per-hop budget for AuthService -> UserService directory calls; keep it below
# the gateway's GRPC_AUTH_TIMEOUT_MS so the outer deadline rules.
GRPC_USER_DIRECTORY_TIMEOUT_MS=250
GRPC_CONTENT_SERVICE=content-service:50053
GRPC_SOCIAL_SERVICE=social-service:50054
GRPC_CHAT_SERVICE=chat-service:50055
GRPC_MESSAGE_SERVICE=message-service:50056
GRPC_DISCOVERY_SERVICE=discovery-service:50057
GRPC_FEED_SERVICE=feed-service:50058
GRPC_RISK_SERVICE=risk-service:50059
GRPC_MODERATION_SERVICE=moderation-service:50060

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Security Keys
# Generate independent random values before starting; never reuse these placeholders in deployment.
JWT_SECRET=replace-with-independent-random-jwt-secret-at-least-32-bytes
WS_TICKET_SECRET=replace-with-independent-random-ws-secret-at-least-32-bytes
# Generate separate random values for each internal gRPC direction in deployment.
INTERNAL_RPC_GATEWAY_AUTH_TOKEN=replace-with-independent-random-gateway-auth-token-at-least-32-bytes
INTERNAL_RPC_GATEWAY_USER_TOKEN=replace-with-independent-random-gateway-user-token-at-least-32-bytes
INTERNAL_RPC_AUTH_USER_TOKEN=replace-with-independent-random-auth-user-token-at-least-32-bytes

# Social login (secrets are consumed only by auth-service)
ENABLE_WECHAT_LOGIN=false
ENABLE_QQ_LOGIN=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_IDENTITY_NAMESPACE=wechat-main
# Local E2E may override these with the compose fake-oauth service. Keep the
# official HTTPS defaults for every non-E2E environment.
WECHAT_TOKEN_ENDPOINT=https://api.weixin.qq.com/sns/oauth2/access_token
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=
QQ_IDENTITY_NAMESPACE=qq-main
QQ_TOKEN_ENDPOINT=https://graph.qq.com/oauth2.0/token
QQ_OPEN_ID_ENDPOINT=https://graph.qq.com/oauth2.0/me
# Only the local/testing fake OAuth service may use HTTP; production stays HTTPS.
SOCIAL_OAUTH_ALLOW_INSECURE_HTTP=false
SOCIAL_HTTP_CONNECT_TIMEOUT_MS=1000
SOCIAL_HTTP_TIMEOUT_MS=3000
GRPC_AUTH_TIMEOUT_MS=300
# Both social RPCs alternate OAuth HTTP requests with Auth→User gRPC hops; QQ
# sends two OAuth HTTP requests, so each deadline must stay above
# 2 * SOCIAL_HTTP_TIMEOUT_MS or the gateway refuses to start.
GRPC_SOCIAL_LOGIN_TIMEOUT_MS=7000
GRPC_SOCIAL_BIND_TIMEOUT_MS=7000
PHONE_DEFAULT_REGION=CN
# Layered social rate limits (all requests must pass every bucket):
# SOCIAL_LOGIN_RATE_LIMIT is the per-IP ceiling across login+bind together —
# keep it generous, carrier CGNAT shares one IPv4 across real users; the
# scenario/device/user buckets below carry the fine-grained limits.
SOCIAL_LOGIN_RATE_LIMIT=60
SOCIAL_LOGIN_RATE_WINDOW_SECONDS=60
# Per IP+scenario (login vs bind) allowance within the window.
SOCIAL_LOGIN_RATE_SCENARIO_LIMIT=30
# Per (IP, device_uuid) allowance; a risk signal that only tightens.
SOCIAL_LOGIN_RATE_DEVICE_LIMIT=20
# Per authenticated-user bind allowance over its own window.
SOCIAL_BIND_USER_RATE_LIMIT=10
SOCIAL_BIND_USER_RATE_WINDOW_SECONDS=3600
# Only proxy addresses you control; empty means direct socket peer only.
SOCIAL_TRUSTED_PROXY_CIDRS=

# Snowflake worker slot (0-31). compose.yaml injects WORKER_ID per service;
# only set this for non-Docker local runs. Replicas of the same service need
# distinct values.
# WORKER_ID=1

# Phone (SMS) login is a local/E2E-only capability and is disabled in
# production by both the Gateway route environment gate and AuthService.
ENABLE_DEV_LOGIN=true
DEV_LOGIN_CODE=123456
