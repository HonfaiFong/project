APP_ENV=local
APP_NAME=social-backend
SERVICE_NAME=api-gateway
SERVICE_INSTANCE_ID=gw-01

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-random-local-mysql-password

# Databases
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
CONTENT_DB_NAME=content_db
SOCIAL_DB_NAME=social_db
CHAT_DB_NAME=chat_db
MESSAGE_DB_NAME=message_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (KRaft)
KAFKA_BROKERS=kafka:9092

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace-with-random-local-minio-password
MINIO_BUCKET=social-media

# gRPC Services
GRPC_AUTH_SERVICE=auth-service:50051
GRPC_USER_SERVICE=user-service:50052
GRPC_CONTENT_SERVICE=content-service:50053
GRPC_SOCIAL_SERVICE=social-service:50054
GRPC_CHAT_SERVICE=chat-service:50055
GRPC_MESSAGE_SERVICE=message-service:50056
GRPC_DISCOVERY_SERVICE=discovery-service:50057
GRPC_FEED_SERVICE=feed-service:50058
GRPC_RISK_SERVICE=risk-service:50059
GRPC_MODERATION_SERVICE=moderation-service:50060

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Security Keys
# Generate independent random values before starting; never reuse these placeholders in deployment.
JWT_SECRET=replace-with-independent-random-jwt-secret-at-least-32-bytes
WS_TICKET_SECRET=replace-with-independent-random-ws-secret-at-least-32-bytes

# Snowflake worker slot (0-31). compose.yaml injects WORKER_ID per service;
# only set this for non-Docker local runs. Replicas of the same service need
# distinct values.
# WORKER_ID=1

# Only for local E2E. Production must use a real verification provider.
ENABLE_DEV_LOGIN=true
DEV_LOGIN_CODE=123456
